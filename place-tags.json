{
 "about": "Tags for the 'I've got some time' feature. Minutes are judgement, not measurement. Match entries to app places by name; names follow the owner's Google Maps list.",
 "fields": {
  "moods": "view, church, square, fountain, ancient, art, park, wander, coffee, sweet, snack, meal, drink, music",
  "minutes": "typical time spent there, excluding the walk and any queue",
  "queue_minutes": "typical extra wait, where there is one",
  "climb_minutes": "extra walking time to add for the hill, on top of the distance estimate",
  "setting": "indoor, outdoor, either. Demote outdoor when rain is forecast.",
  "booking": "required = never suggest spontaneously unless there is a booking; advised = suggest with a label",
  "confidence": "check = type or details are my best guess; unidentified = I could not work out what this place is, so exclude it until tagged",
  "key": "for plan stops: the place's key in the app's P table, added so the app can match it"
 },
 "hours_rules": {
  "always": "Public space. Suggest at any hour.",
  "basilica": "Major church open through the day, roughly 07:00 to 18:30. Label 'check it's open' after 18:00.",
  "church": "Assume shut roughly 12:30 to 15:30 and after about 18:30. In those windows demote and label 'probably shut until mid-afternoon'. Otherwise label 'check it's open'.",
  "ticketed": "Daytime with a last entry. Use the note; otherwise don't suggest within 90 minutes of 18:00 without a label.",
  "daytime": "Roughly 09:00 to 18:00. Don't suggest in the evening.",
  "kitchen": "Lunch roughly 12:30 to 15:00 and dinner roughly 19:30 to 22:30. Don't suggest a meal outside those.",
  "allday": "Open continuously from morning or midday into the evening.",
  "evening": "From about 18:00 for bars, later for music. Don't suggest before then.",
  "unknown": "No basis for a rule. Always label 'check hours'."
 },
 "mood_rules": [
  "view: boost during golden hour; drop after dark unless the place is also a square or fountain.",
  "music: only when the venue has something listed tonight.",
  "meal: needs at least 60 minutes in the budget.",
  "River: add 5 minutes when the walk crosses the Tiber, since crossings only happen at bridges."
 ],
